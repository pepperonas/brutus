<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: what cloud backup and device transfer take along. Alarms (database), the global QR
    code, settings, world clocks and the timer sound go; state that only describes this phone's
    current moment stays behind — restored on another phone it would ring stale snoozes, report
    alarms as missed that were never due there, or re-arm Ultra Hardcore follow-ups.
    Keep in sync with backup_rules.xml (Android 11 and older); BackupRulesTest checks both.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="device_sharedpref" path="brutus_ringing.xml" />
        <exclude domain="device_sharedpref" path="brutus_ultra_hardcore.xml" />
        <exclude domain="device_sharedpref" path="brutus_timer_state.xml" />
        <exclude domain="device_sharedpref" path="brutus_updates.xml" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="device_sharedpref" path="brutus_ringing.xml" />
        <exclude domain="device_sharedpref" path="brutus_ultra_hardcore.xml" />
        <exclude domain="device_sharedpref" path="brutus_timer_state.xml" />
        <exclude domain="device_sharedpref" path="brutus_updates.xml" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
